<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Brawnson Module -->
  <ThingDef ParentName="ModuleItemBase">
    <defName>Amiti_Module_Pirate_Brawnson_Core</defName>
    <label>PV-8R0N "Brawnson" core module</label>
    <description>Desperate for a solution to the Colonization Fleet's PV8, both independant polities and raider bands desperately tried to create their own PV8. With old refurbished AT34 frames and PV8 core systems and plating, the "Brawnson" was born. This rather bulky and unconventional frame has an almost prohibitive amount of plating on it, with the hydraulics system almost failing to handle the added weight. Nonetheless, it can go toe to toe with the PV8; although more often plays the role of an gun emplacement rather than a proper Mobile Dragoon.</description>
	<graphicData>
      <texPath>Things/Item/ModuleP</texPath>
    </graphicData>
	
    <descriptionHyperlinks>
      <ThingDef>Amiti_Apparel_Pirate_PV8_Brawnson</ThingDef>
    </descriptionHyperlinks>
	
    <statBases>
      <MaxHitPoints>280</MaxHitPoints>
      <Mass>120</Mass>
    </statBases>
	
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>Amiti_Apparel_Pirate_PV8_Brawnson</EquipedThingDef>
        <occupiedSlots>
          <li>Core</li>
        </occupiedSlots>
      </li>
    </comps>
	
	    <recipeMaker>
      <researchPrerequisite>DMS_MobileDragoon</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
	   <recipeUsers>
        <li>FabricationBench</li>
      </recipeUsers>
      <workAmount>80000</workAmount>
	  <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
	
    <smeltProducts>
      <Steel>200</Steel>
      <Tungsteel>240</Tungsteel>
    </smeltProducts>
	
    <butcherProducts>
      <Tungsteel>200</Tungsteel>
      <Artifuscle>110</Artifuscle>
      <Steel>75</Steel>
      <ChunkSlagSteel>3</ChunkSlagSteel>
      <ComponentIndustrial>3</ComponentIndustrial>
      <ComponentStamped>4</ComponentStamped>
    </butcherProducts>
	
    <costList>
      <Tungsteel>450</Tungsteel>
      <Artifuscle>260</Artifuscle>
      <Steel>125</Steel>
      <ComponentStamped>12</ComponentStamped>
      <ComponentIndustrial>12</ComponentIndustrial>
      <Neurocomputer>1</Neurocomputer>
    </costList>
	
  </ThingDef>

  <ThingDef ParentName="ModuleApparelCore">
    <defName>Amiti_Apparel_Pirate_PV8_Brawnson</defName>
    <label>PV-8R0N "Brawnson" core module</label>
    <description>Desperate for a solution to the Colonization Fleet's PV8, both independant polities and raider bands desperately tried to create their own PV8. With old refurbished AT34 frames and PV8 core systems and plating, the "Brawnson" was born. This rather bulky and unconventional frame has an almost prohibitive amount of plating on it, with the hydraulics system almost failing to handle the added weight. Nonetheless, it can go toe to toe with the PV8; although more often plays the role of an gun emplacement rather than a proper Mobile Dragoon.</description>
	<thingClass>Exosuit.Exosuit_Core</thingClass>
	 <uiIconPath>Things/Dragoon/Brawnson/apparelBrawnson_south</uiIconPath>
    <graphicData>
      <texPath>Things/Dragoon/Brawnson/Brawnson</texPath>
	  <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <tickerType>Normal</tickerType>
    <descriptionHyperlinks>
      <ThingDef>Amiti_Module_Pirate_Brawnson_Core</ThingDef>
    </descriptionHyperlinks>
	<comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>Amiti_Module_Pirate_Brawnson_Core</ItemDef>
        <occupiedSlots>
          <li>Core</li>
        </occupiedSlots>
      </li>
    </comps>
	
    <statBases>
      <Mass>120</Mass>
      <MoveSpeed>5.2</MoveSpeed>
      <ArmorRating_Sharp>1.60</ArmorRating_Sharp>
      <ArmorRating_Blunt>1.30</ArmorRating_Blunt>
      <ArmorRating_Heat>0.70</ArmorRating_Heat>
      <Insulation_Cold>48</Insulation_Cold>
      <Insulation_Heat>64</Insulation_Heat>
    </statBases>
	
    <equippedStatOffsets>
      <VacuumResistance MayRequire="ludeon.rimworld.odyssey">0.35</VacuumResistance>
      <CarryingCapacity>320</CarryingCapacity>
      <CarryWeight MayRequire="ceteam.combatextended">270</CarryWeight>
      <WorkSpeedGlobal>-0.35</WorkSpeedGlobal>
      <DecompressionResistance MayRequire="kentington.saveourship2">0.75</DecompressionResistance>
    </equippedStatOffsets>
	
    <apparel>
      <wornGraphicPath>Things/Dragoon/Brawnson/apparelBrawnson</wornGraphicPath>
	  <parentTagDef>WGApparelBody</parentTagDef>
      <drawData>
        <dataNorth>
          <layer>5</layer>
        </dataNorth>
        <scale>1.5</scale>
      </drawData>
		<bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Feet</li>
        <li>Hands</li>
      </bodyPartGroups>
      <layers>
        <li>Shell</li>
        <li>WG_WalkerGearLayer_Core</li>
      </layers>
      <renderSkipFlags>
          <li>Body</li>
      </renderSkipFlags>
    </apparel>
	
    <modExtensions>
      <li Class="Exosuit.ApparelRenderOffsets">
        <headData>
          <dataWest>
            <offset>(-0.29,0,0.44)</offset>
          </dataWest>
          <dataEast>
            <offset>(0.29,0,0.44)</offset>
          </dataEast>
          <dataSouth>
            <offset>(0.00,0,0.40)</offset>
          </dataSouth>
          <dataNorth>
            <offset>(0.00,0,0.40)</offset>
          </dataNorth>
        </headData>
        <headHideFor>
          <li>0</li>
        </headHideFor>
        <rootData>
          <defaultData>
            <offset>(0,0,0.26)</offset>
          </defaultData>
        </rootData>
        <equipmentOffsetData>
          <dataWest>
            <offset>(-0.35,-1,0.6)</offset>
          </dataWest>
          <dataEast>
            <offset>(0.25,0,0)</offset>
          </dataEast>
          <dataSouth>
            <offset>(-0.25,0,0)</offset>
          </dataSouth>
          <dataNorth>
            <offset>(0.25,0,0)</offset>
          </dataNorth>
        </equipmentOffsetData>
      </li>
    </modExtensions>
  </ThingDef>
  
  <!-- Brawnson helmot module -->
  <ThingDef ParentName="ModuleItemHead">
    <defName>Amiti_Pirate_Brawnson_Module_Helmet</defName>
    <label>PV-8R0N "Brawnson" helmet</label>
    <description>A heavy helmet with large faceplate. Due to the amount of plating and padding, noise insulation is quite good, and a communications module was attached to the back of the head.</description>
	
	<graphicData>
      <texPath>Things/Item/ModuleP</texPath>
    </graphicData>
	
    <descriptionHyperlinks>
      <ThingDef>Amiti_Apparel_Pirate_Brawnson_Helmet</ThingDef>
    </descriptionHyperlinks>
	
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>60</Mass>
    </statBases>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>Amiti_Apparel_Pirate_Brawnson_Helmet</EquipedThingDef>
        <occupiedSlots>
          <li>Head</li>
        </occupiedSlots>
      </li>
    </comps>
	
    <recipeMaker>
      <researchPrerequisite>DMS_MobileDragoon</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <workAmount>30000</workAmount>
	  <recipeUsers>
	  <li>FabricationBench</li>
      </recipeUsers>
      <workAmount>20000</workAmount>
	  <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
	
    <smeltProducts>
      <Steel>80</Steel>
      <Tungsteel>45</Tungsteel>
    </smeltProducts>
	
    <butcherProducts>
      <Tungsteel>40</Tungsteel>
      <Steel>10</Steel>
      <ChunkSlagSteel>2</ChunkSlagSteel>
      <ComponentIndustrial>4</ComponentIndustrial>
      <ComponentStamped>3</ComponentStamped>
    </butcherProducts>
	
    <costList>
      <Tungsteel>80</Tungsteel>
      <Steel>80</Steel>
      <ComponentIndustrial>2</ComponentIndustrial>
      <ComponentStamped>4</ComponentStamped>
    </costList>
  </ThingDef>
  
  
  <ThingDef ParentName="ModuleApparelHead">
    <defName>Amiti_Apparel_Pirate_Brawnson_Helmet</defName>
    <label>PV-8R0N "Brawnson" helmet</label>
    <description>A heavy helmet with large faceplate. Due to the amount of plating and padding, noise insulation is quite good, and a communications module was attached to the back of the head.</description>
	
    <graphicData>
      <texPath>Things/Dragoon/Brawnson/helmetBrawnson_south</texPath>
    </graphicData>
	
    <descriptionHyperlinks>
      <ThingDef>Amiti_Pirate_Brawnson_Module_Helmet</ThingDef>
    </descriptionHyperlinks>
	
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <Mass>60</Mass>
    </statBases>
	
    <equippedStatOffsets>
      <MoveSpeed>-0.3</MoveSpeed>
	  <ShootingAccuracyPawn>2.5</ShootingAccuracyPawn>
	  <AimingDelayFactor>-0.90</AimingDelayFactor>
      <VacuumResistance MayRequire="ludeon.rimworld.odyssey">0.5</VacuumResistance>
      <HypoxiaResistance MayRequire="kentington.saveourship2">1</HypoxiaResistance>
      <DecompressionResistance MayRequire="kentington.saveourship2">0.25</DecompressionResistance>
    </equippedStatOffsets>
    <apparel>
      <immuneToToxGasExposure>true</immuneToToxGasExposure>
      <wornGraphicPath>Things/Dragoon/Brawnson/helmetBrawnson</wornGraphicPath>
      <tags>
        <li>EVA</li>
      </tags>
    </apparel>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>Amiti_Pirate_Brawnson_Module_Helmet</ItemDef>
        <occupiedSlots>
          <li>Head</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>
</Defs>