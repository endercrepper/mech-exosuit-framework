<?xml version="1.0" encoding="UTF-8"?>

<Defs>

  <!-- Autocannon -->

  <ThingDef ParentName="ModuleItemArmRight">
    <defName>Aqued_Exosuit_Module_Autocannon</defName>
    <label>Exosuit Autocannon</label>
    <description>An autocannon made for the EXO-49 Emancipator Exosuit. It fires high penetration explosive rounds allowing them to stagger heavy-armored units. They are capable of easily dispatching groups of medium-armored enemies.</description>
    <descriptionHyperlinks>
      <ThingDef>Aqued_Exosuit_Weapon_Autocannon</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Module_AR</texPath>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>25.70</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisites>
        <li>WG_HeavyExoskeleton</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <workAmount>15000</workAmount>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <costList>
      <Plasteel>65</Plasteel>
      <Uranium>11</Uranium>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>Aqued_Exosuit_Apparel_Autocannon</EquipedThingDef>
        <occupiedSlots>
          <li>ArmRight</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelArmRight">
    <defName>Aqued_Exosuit_Apparel_Autocannon</defName>
