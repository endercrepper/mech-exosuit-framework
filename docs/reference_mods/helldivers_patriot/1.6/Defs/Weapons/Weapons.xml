    <descriptionHyperlinks>
      <ThingDef>Aqued_Exosuit_Weapon_Autocannon</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Weapons/Autocannon</texPath>
    </graphicData>
    <uiIconScale>1</uiIconScale>
    <statBases>
      <Mass>30.70</Mass>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>WG_WalkerGearLayer</li>
      </layers>
      <parentTagDef>WGApparelBody</parentTagDef>
      <renderNodeProperties>
        <li Class="Exosuit.PawnRenderNodeProperties_ApparelWeaponHolder">
          <parentTagDef>WGApparelBody</parentTagDef>
          <drawData>
            <scale>1.8</scale>
            <dataSouth>
              <offset>(-1.2,0,-0.55)</offset>
              <layer>25</layer>
              <rotationOffset>135</rotationOffset>
            </dataSouth>
            <dataNorth>
              <offset>(1.30,0,1)</offset>
              <layer>0</layer>
              <rotationOffset>-47</rotationOffset>
            </dataNorth>
            <dataWest>
              <offset>(-0.5,0,0.8)</offset>
              <layer>-10</layer>
              <rotationOffset>-45</rotationOffset>
            </dataWest>
            <dataEast>
              <offset>(0.1,0,-1)</offset>
              <layer>71</layer>
              <rotationOffset>45</rotationOffset>
            </dataEast>
          </drawData>
        </li>
      </renderNodeProperties>
    </apparel>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>Aqued_Exosuit_Module_Autocannon</ItemDef>
        <occupiedSlots>
          <li>ArmRight</li>
        </occupiedSlots>
      </li>
      <li Class="Exosuit.CompProperties_ModuleWeapon">
        <weapon>Aqued_Exosuit_Weapon_Autocannon</weapon>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseGunWithQuality">
    <defName>Aqued_Exosuit_Weapon_Autocannon</defName>
    <label>Exosuit Autocannon</label>
    <description>An autocannon made for the EXO-49 Emancipator Exosuit. It fires high penetration explosive rounds allowing them to stagger heavy-armored units. They are capable of easily dispatching groups of medium-armored enemies.</description>
    <graphicData>
      <texPath>Weapons/Autocannon</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>2.5</drawSize>
    </graphicData>
    <uiIconPath>Weapons/Autocannon</uiIconPath>
    <uiIconScale>1</uiIconScale>
    <statBases>
      <MarketValue>3000</MarketValue>
      <Mass>0</Mass>
      <AccuracyTouch>0.50</AccuracyTouch>
      <AccuracyShort>0.60</AccuracyShort>
      <AccuracyMedium>0.70</AccuracyMedium>
      <AccuracyLong>0.7</AccuracyLong>
      <RangedWeapon_Cooldown>3</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_ExosuitAutocannonBullet</defaultProjectile>
        <warmupTime>0.5</warmupTime>
        <range>45.9</range>
        <forcedMissRadius>0.9</forcedMissRadius>
        <ticksBetweenBurstShots>12</ticksBetweenBurstShots>
        <burstShotCount>4</burstShotCount>
        <soundCast>Shot_TurretSniper</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <equippedAngleOffset>55</equippedAngleOffset>
    <smeltable>false</smeltable>
    <techLevel>Ultra</techLevel>
    <destroyOnDrop>true</destroyOnDrop>
    <generateCommonality>0</generateCommonality>
    <useHitPoints>true</useHitPoints>
    <tickerType>Normal</tickerType>
    <tradeability>None</tradeability>
    <relicChance>0</relicChance>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>30</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
    <comps>
      <li>
        <compClass>Exosuit.CompApparelForcedWeapon</compClass>
      </li>
    </comps>
    <modExtensions>
      <li Class="VEF.Things.ThingDefExtension" MayRequire="OskarPotocki.VanillaFactionsExpanded.Core">
        <weaponCarryDrawOffsets>
          <north>
            <drawOffset>(1.25,0,0.9)</drawOffset>
          </north>
          <east>
            <drawOffset>(0,0,-0.9)</drawOffset>
          </east>
          <south>
            <drawOffset>(-1.1,0,0)</drawOffset>       
          </south>
          <west>
            <drawOffset>(-0.10,-1,1)</drawOffset>
          </west>
        </weaponCarryDrawOffsets>
        <weaponDraftedDrawOffsets>
          <north>
            <angleOffset>-153</angleOffset>
          </north>
          <east>
            <angleOffset>-63</angleOffset>
          </east>
          <south>      <!-- -Left/+Right, -Back/+Front, -Down/+Up -->
            <angleOffset>27</angleOffset>
          </south>
          <west>
            <angleOffset>63</angleOffset>
          </west>
        </weaponDraftedDrawOffsets>
      </li>
    </modExtensions>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_ExosuitAutocannonBullet</defName>
    <label>autocannon bullet</label>
    <graphicData>
      <texPath>Things/Projectile/Bullet_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>AutocannonBullet</damageDef>
      <damageAmountBase>30</damageAmountBase>
      <explosionRadius>0.6</explosionRadius>
      <stoppingPower>1.5</stoppingPower>
      <speed>100</speed>
    </projectile>
  </ThingDef>

  <DamageDef ParentName="Bomb">
    <defName>AutocannonBullet</defName>
    <defaultDamage>30</defaultDamage>
    <buildingDamageFactorImpassable>2</buildingDamageFactorImpassable>
    <buildingDamageFactorPassable>0.5</buildingDamageFactorPassable>
    <defaultStoppingPower>1.0</defaultStoppingPower>
    <defaultArmorPenetration>1</defaultArmorPenetration>
  </DamageDef>

