  <ThingDef ParentName="ModuleItemMountLeft">
    <defName>Aqued_Exosuit_Module_Rocket_Launcher</defName>
    <label>Rocket Launcher</label>
    <description>A shoulder-mounted rocket launcher housing 6 rockets, made for the EXO-45 Patriot Exosuit. It is effective against heavy-armored enemies and can destroy facilities. A clear line of sight is required and the pod needs to be reloaded after the rockets have been fired.</description>
    <descriptionHyperlinks>
      <ThingDef>Aqued_Exosuit_Apparel_Rocket_Launcher</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Module_AL</texPath>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <uiIconScale>1</uiIconScale>
    <recipeMaker>
      <researchPrerequisites>
        <li>WG_HeavyExoskeleton</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedWeapon</unfinishedThingDef>
      <workAmount>10000</workAmount>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>40</Mass>
    </statBases>
    <costList>
      <Plasteel>50</Plasteel>
      <Uranium>8</Uranium>
      <ComponentIndustrial>5</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>Aqued_Exosuit_Apparel_Rocket_Launcher</EquipedThingDef>
        <occupiedSlots>
          <li>MountLeft</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelMountLeft">
    <defName>Aqued_Exosuit_Apparel_Rocket_Launcher</defName>
    <label>Rocket Launcher</label>
    <description>A shoulder-mounted rocket launcher housing 6 rockets, made for the EXO-45 Patriot Exosuit. It is effective against heavy-armored enemies and can destroy facilities. A clear line of sight is required and the pod needs to be reloaded after the rockets have been fired.</description>
    <descriptionHyperlinks>
      <ThingDef>Aqued_Exosuit_Module_Rocket_Launcher</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>RocketLauncher/Rocket_south</texPath>
    </graphicData>
    <uiIconPath>RocketLauncher/Rocket_south</uiIconPath>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <Mass>40</Mass>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.2</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
      </bodyPartGroups>
      <layers>
        <li>WG_WalkerGearLayer_Utility</li>
      </layers>
      <useWornGraphicMask>true</useWornGraphicMask>
      <wornGraphicPath>RocketLauncher/Rocket</wornGraphicPath>
      <drawData>
        <scale>2</scale>
        <dataSouth>
          <offset>(1.3,0,0.2)</offset>
          <layer>80</layer>
        </dataSouth>
        <dataNorth>
          <offset>(-1.25,0,0.3)</offset>
          <layer>80</layer>
        </dataNorth>
        <dataWest>
          <offset>(0,0,-0.8)</offset>
          <layer>80</layer>
        </dataWest>
        <dataEast>
          <offset>(0,0,0.75)</offset>
          <layer>-2</layer>
        </dataEast>
      </drawData>
    </apparel>
    <verbs>
      <li>
        <label>launch missile</label>
        <verbClass>Verb_LaunchProjectile</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <commandIcon>Things/Projectile/Rocket_Big</commandIcon>
        <onlyManualCast>True</onlyManualCast>
        <range>55.9</range>
        <forcedMissRadius>1.9</forcedMissRadius>
        <warmupTime>2</warmupTime>
        <noiseRadius>4</noiseRadius>
        <ai_IsWeapon>false</ai_IsWeapon>
        <targetable>true</targetable>
        <ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
        <soundCast>RocketswarmLauncher_Fire</soundCast>
        <soundCastTail>GunTail_Medium</soundCastTail>
        <muzzleFlashScale>14</muzzleFlashScale>
        <drawHighlightWithLineOfSight>false</drawHighlightWithLineOfSight>
        <targetParams>
          <canTargetLocations>true</canTargetLocations>
          <canTargetBuildings>true</canTargetBuildings>
        </targetParams>
        <defaultProjectile>Bullet_RocketHelldivers</defaultProjectile>
        <rangedFireRulepack>Combat_RangedFire</rangedFireRulepack>
      </li>
    </verbs>
    <comps>
      <li Class="CompProperties_ApparelReloadable">
        <maxCharges>6</maxCharges>
        <ammoDef>Chemfuel</ammoDef>
        <ammoCountPerCharge>20</ammoCountPerCharge>
        <baseReloadTicks>60</baseReloadTicks>
        <soundReload>Standard_Reload</soundReload>
        <hotKey>Misc4</hotKey>
        <chargeNoun>rocket</chargeNoun>
        <displayGizmoWhileUndrafted>false</displayGizmoWhileUndrafted>
      </li>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>Aqued_Exosuit_Module_Rocket_Launcher</ItemDef>
        <occupiedSlots>
          <li>MountLeft</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseBullet">
    <defName>Bullet_RocketHelldivers</defName>
    <label>rocket</label>
    <graphicData>
      <texPath>Things/Projectile/Rocket_Big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>TransparentPostLight</shaderType>
    </graphicData>
    <thingClass>Projectile_Explosive</thingClass>
    <projectile>
      <damageDef>Bomb</damageDef>
      <damageAmountBase>60</damageAmountBase>
      <explosionRadius>3.9</explosionRadius>
      <speed>55</speed>
    </projectile>
  </ThingDef>

</Defs>
