<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!--GAU-90-->
  <ThingDef ParentName="ModuleItemBase"><!--module-->
    <defName>AMP_Module_Rifle</defName>
    <label>GAU-90</label>
    <description>a massive 30mm-caliber autocannon used by AMP suit and it is unusable for humans. can fire high explosive, armor-piercing, or incendiary munitions at up to 250 rounds per minute, and has a large underslung bayonet below the barrel for close-quarter melee.</description>
    <descriptionHyperlinks>
      <ThingDef>AMP_Weapon_Rifle</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Item/AMP_GAU90</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>100.70</Mass>
    </statBases>
    <recipeMaker>
      <researchPrerequisites>
        <li>AMP_Rifle</li>
      </researchPrerequisites>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <workAmount>50000</workAmount>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <costList>
      <Steel>250</Steel>
      <Uranium>150</Uranium>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>AMP_Apparel_Rifle</EquipedThingDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelBase"><!--apprel-->
    <defName>AMP_Apparel_Rifle</defName>
    <label>GAU-90</label>
    <description>a massive 30mm-caliber autocannon used by AMP suit and it is unusable for humans. can fire high explosive, armor-piercing, or incendiary munitions at up to 250 rounds per minute, and has a large underslung bayonet below the barrel for close-quarter melee.</description>
    <descriptionHyperlinks>
      <ThingDef>AMP_Weapon_Rifle</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Weapons/AMP_Rifle</texPath>
    </graphicData>
    <statBases>
      <Mass>100.70</Mass>
    </statBases>
    <apparel>
      <parentTagDef>WGApparelBody</parentTagDef> <!-- important, or your parts will not rendered at bay.-->
      <renderNodeProperties>
        <li>
          <debugLabel>Ammobelt top</debugLabel>
          <nodeClass>PawnRenderNode</nodeClass>
          <workerClass>PawnRenderNodeWorker</workerClass>
          <parentTagDef>WGApparelBody</parentTagDef>
          <baseLayer>20</baseLayer>
          <drawSize>1.75</drawSize>
          <pawnType>Any</pawnType>
          <useGraphic>true</useGraphic>
          <texPath>Things/AMPSuit/AMP_Ammobelt_Top</texPath>
          <drawData>
            <defaultData>
              <layer>20</layer>
            </defaultData>
            <dataEast>
              <offset>(0,0,0)</offset>
            </dataEast>
            <dataWest>
              <offset>(0,0,-0.1)</offset>
              <layer>-1</layer>
            </dataWest>
            <dataNorth>
              <offset>(0,0,0)</offset>
              <layer>-1</layer>
            </dataNorth>
            <dataSouth>
              <offset>(0,0,0)</offset>
              <layer>10</layer>
            </dataSouth>
          </drawData>
        </li>
        <li>
          <debugLabel>Ammobelt</debugLabel>
          <nodeClass>PawnRenderNode</nodeClass>
          <workerClass>PawnRenderNodeWorker</workerClass>
          <parentTagDef>WGApparelBody</parentTagDef>
          <baseLayer>20</baseLayer>
          <drawSize>1.75</drawSize>
          <pawnType>Any</pawnType>
          <useGraphic>true</useGraphic>
          <texPath>Things/AMPSuit/AMP_Ammobelt</texPath>
          <drawData>
            <defaultData>
              <layer>20</layer>
            </defaultData>
            <dataEast>
              <offset>(0,0,0)</offset>
              <layer>-1</layer>
            </dataEast>
            <dataWest>
              <offset>(0,0,-0.1)</offset>
              <layer>-2</layer>
            </dataWest>
            <dataNorth>
              <offset>(0,0,0)</offset>
            </dataNorth>
            <dataSouth>
              <offset>(0,0,0)</offset>
              <layer>-2</layer>
            </dataSouth>
          </drawData>
        </li>
        <li Class="Exosuit.PawnRenderNodeProperties_ApparelWeaponHolder">
          <parentTagDef>WGApparelBody</parentTagDef>
          <drawData>
            <scale>1.7</scale>
            <dataSouth>
              <offset>(-0.85,0,0.10)</offset>
              <layer>25</layer>
              <rotationOffset>270</rotationOffset>
            </dataSouth>
            <dataNorth>
              <offset>(0.75,0,0.0)</offset>
              <layer>0</layer>
              <rotationOffset>270</rotationOffset>
            </dataNorth>
            <dataWest>
              <offset>(-0.40,0,0.5)</offset>
              <layer>10</layer>
              <rotationOffset>100</rotationOffset>
            </dataWest>
            <dataEast>
              <offset>(-0.2,0,-0.1)</offset>
              <layer>25</layer>
              <rotationOffset>250</rotationOffset>
            </dataEast>
          </drawData>
        </li>
      </renderNodeProperties>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>ExosuitLayer_Core</li>
      </layers>
    </apparel>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>AMP_Module_Rifle</ItemDef>
        <occupiedSlots>
          <li>ArmRight</li>
          <li>ArmLeft</li>
        </occupiedSlots>
      </li>
      <li Class="Exosuit.CompProperties_ModuleWeapon">
        <weapon>AMP_Weapon_Rifle</weapon>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseWalkerWeapon"><!--weapon-->
    <defName>AMP_Weapon_Rifle</defName>
    <label>GAU-90</label>
    <description>a massive 30mm-caliber autocannon used by AMP suit and it is unusable for humans. can fire high explosive, armor-piercing, or incendiary munitions at up to 250 rounds per minute, and has a large underslung bayonet below the barrel for close-quarter melee.</description>
    <graphicData>
      <texPath>Things/Weapons/AMP_Rifle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>2.5</drawSize>
    </graphicData>
    <statBases>
      <MarketValue>2000</MarketValue>
      <Mass>0</Mass>
      <AccuracyTouch>0.48</AccuracyTouch>
      <AccuracyShort>0.72</AccuracyShort>
      <AccuracyMedium>0.76</AccuracyMedium>
      <AccuracyLong>0.6</AccuracyLong>
      <RangedWeapon_Cooldown>2.0</RangedWeapon_Cooldown>
    </statBases>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Bullet_AutocannonTurret</defaultProjectile>
        <warmupTime>1</warmupTime>
        <minRange>2.9</minRange>
        <range>32.9</range>
        <ticksBetweenBurstShots>15</ticksBetweenBurstShots>
        <burstShotCount>6</burstShotCount>
        <soundCast>Shot_TurretSniper</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>9</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
      <li>
        <label>bayonet</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>28</power>
        <cooldownTime>1.3</cooldownTime>
      </li>
    </tools>
		<modExtensions>
			<li Class="MuzzleFlash.MuzzleFlashProps" MayRequire="IssacZhuang.MuzzleFlash">
				<def>MF_StandardMuzzleFalsh</def>
				<drawSize>(1.75,1.75)</drawSize>
				<offsets>
					<li>(0.9,0.1)</li>
				</offsets>
				<isAlternately>false</isAlternately>
			</li>
    </modExtensions>
  </ThingDef>
</Defs>	