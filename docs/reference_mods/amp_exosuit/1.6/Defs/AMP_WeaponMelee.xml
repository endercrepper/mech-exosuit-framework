<?xml version="1.0" encoding="utf-8"?>
<Defs>
  
  <ThingDef ParentName="ModuleItemBase">
    <defName>AMP_Module_Dagger</defName>
    <label>exoskeleton dagger</label>
    <description>an dagger design for AMP exoskeleton,its size is unusable for humans.</description>
    <descriptionHyperlinks>
      <ThingDef>AMP_Weapon_Dagger</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Item/AMP_Dagger</texPath>
    </graphicData>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <Mass>20.50</Mass>
    </statBases>
    <recipeMaker>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>TableMachining</li>
      </recipeUsers>
      <researchPrerequisites>
        <li>AMP_Core</li>
      </researchPrerequisites>
      <effectWorking>Repair</effectWorking>
      <unfinishedThingDef>UnfinishedComponent</unfinishedThingDef>
      <workAmount>10000</workAmount>
      <soundWorking>Recipe_Machining</soundWorking>
    </recipeMaker>
    <costList>
      <Steel>75</Steel>
    </costList>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <EquipedThingDef>AMP_Apparel_Dagger</EquipedThingDef>
        <occupiedSlots>
          <li>ArmRight</li>
        </occupiedSlots>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="ModuleApparelBase">
    <defName>AMP_Apparel_Dagger</defName>
    <label>exoskeleton dagger</label>
    <description>an dagger design for AMP exoskeleton,its size is unusable for humans.</description>
    <descriptionHyperlinks>
      <ThingDef>AMP_Weapon_Dagger</ThingDef>
    </descriptionHyperlinks>
    <graphicData>
      <texPath>Things/Weapons/AMP_Knife</texPath>
    </graphicData>
    <statBases>
      <Mass>20.50</Mass>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Shoulders</li>
      </bodyPartGroups>
      <layers>
        <li>ExosuitLayer_Core</li>
      </layers>
      <parentTagDef>WGApparelBody</parentTagDef>
    </apparel>
    <comps>
      <li Class="Exosuit.CompProperties_ExosuitModule">
        <ItemDef>AMP_Module_Dagger</ItemDef>
        <occupiedSlots>
          <li>ArmRight</li>
        </occupiedSlots>
      </li>
      <li Class="Exosuit.CompProperties_ModuleWeapon">
        <weapon>AMP_Weapon_Dagger</weapon>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BaseWalkerWeapon">
    <defName>AMP_Weapon_Dagger</defName>
    <label>exoskeleton dagger</label>
    <description>an dagger design for AMP exoskeleton,its size is unusable for humans.</description>
    <graphicData>
      <texPath>Things/Weapons/AMP_Knife</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>1.2</drawSize>
    </graphicData>
    <statBases>
      <Mass>0</Mass>
    </statBases>
    <equippedStatOffsets>
      <PlantWorkSpeed>0.35</PlantWorkSpeed>
    </equippedStatOffsets>
    <equippedAngleOffset>-35</equippedAngleOffset>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>15</power>
        <armorPenetration>0.5</armorPenetration>
        <cooldownTime>1.7</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>28</power>
        <armorPenetration>1</armorPenetration>
        <cooldownTime>1.3</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>15</power>
        <armorPenetration>0.8</armorPenetration>
        <cooldownTime>1.3</cooldownTime>
      </li>
    </tools>
  </ThingDef>

</Defs>	