      </li>


      <!--===== GAU90 =====-->
      <li Class="CombatExtended.PatchOperationMakeGunCECompatible">
        <defName>AMP_Weapon_Rifle</defName>
        <statBases>
          <Mass>0</Mass>
          <Bulk>100</Bulk>
          <SwayFactor>4.12</SwayFactor>
          <ShotSpread>0.03</ShotSpread>
          <SightsEfficiency>0.8</SightsEfficiency>
          <RangedWeapon_Cooldown>1</RangedWeapon_Cooldown>
        </statBases>
        <Properties>
          <recoilAmount>1.31</recoilAmount>
          <verbClass>CombatExtended.Verb_ShootCE</verbClass>
          <hasStandardCommand>true</hasStandardCommand>
          <defaultProjectile>Bullet_30x173mmNATO_AP</defaultProjectile>
          <warmupTime>1</warmupTime>
          <range>60</range>
          <ticksBetweenBurstShots>5</ticksBetweenBurstShots>
          <burstShotCount>10</burstShotCount>
          <soundCast>HeavyMG</soundCast>
          <soundCastTail>GunTail_Heavy</soundCastTail>
          <muzzleFlashScale>16</muzzleFlashScale>
          <recoilPattern>Mounted</recoilPattern>
        </Properties>
        <AmmoUser>
          <magazineSize>150</magazineSize>
          <reloadTime>10</reloadTime>
          <ammoSet>AmmoSet_30x173mmNATO</ammoSet>
        </AmmoUser>
        <FireModes>
          <aiAimMode>AimedShot</aiAimMode>
          <aimedBurstShotCount>5</aimedBurstShotCount>
          <noSnapshot>false</noSnapshot>
          <noSingleShot>true</noSingleShot>
        </FireModes>
        <weaponTags>
          <li>NoSwitch</li>
        </weaponTags>
      </li>

      <!--=====Patch tools=====-->
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="AMP_Weapon_Rifle"]/tools</xpath>
        <value>
          <tools>
            <li Class="CombatExtended.ToolCE">
              <label>barrel</label>
              <capacities>
                <li>Blunt</li>
                <li>Poke</li>
              </capacities>
              <power>15</power>
              <cooldownTime>1.6</cooldownTime>
              <armorPenetrationBlunt>21.630</armorPenetrationBlunt>
              <linkedBodyPartsGroup>Barrel</linkedBodyPartsGroup>
            </li>
            <li Class="CombatExtended.ToolCE">
              <label>bayonet blade</label>
              <capacities>
                <li>Cut</li>
              </capacities>
              <power>28</power>
              <cooldownTime>1.18</cooldownTime>
              <chanceFactor>1.33</chanceFactor>
              <armorPenetrationBlunt>12.36</armorPenetrationBlunt>
              <armorPenetrationSharp>2.32</armorPenetrationSharp>
            </li>
            <li Class="CombatExtended.ToolCE">
              <label>bayonet point</label>
              <capacities>
                <li>Stab</li>
              </capacities>
              <power>32</power>
              <cooldownTime>1.2</cooldownTime>
              <chanceFactor>1.5</chanceFactor>
              <armorPenetrationBlunt>10.25</armorPenetrationBlunt>
              <armorPenetrationSharp>4.42</armorPenetrationSharp>
            </li>
          </tools>
        </value>
      </li>


