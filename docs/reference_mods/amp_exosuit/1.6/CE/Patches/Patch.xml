  <Operation Class="PatchOperationSequence">
    <operations>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="AMP_Core"]/statBases</xpath>
        <value>
          <Bulk>275</Bulk>
          <WornBulk>100</WornBulk>
        </value>
      </li>
      <li Class="PatchOperationAdd">
        <xpath>Defs/ThingDef[defName="AMP_Core"]/equippedStatOffsets</xpath>
        <value>
          <CarryBulk>325</CarryBulk>
          <Suppressability>-1</Suppressability>
          <ShootingAccuracyPawn>1</ShootingAccuracyPawn>
        </value>
      </li>
      <li Class="PatchOperationReplace">
        <xpath>Defs/ThingDef[defName="AMP_Core"]/statBases/ArmorRating_Sharp</xpath>
